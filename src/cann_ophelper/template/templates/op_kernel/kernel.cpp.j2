#include "kernel_operator.h"
#include "{{ tiling_header_file }}"
#include "kernel_operator_dump_tensor_intf_impl.h"
constexpr int32_t BUFFER_NUM = 1;  // tensor num for each queue
constexpr int32_t QUEUE_DEPTH = 1;

template <class {{ x.dtype_alias }}, class {{ y.dtype_alias }}, class {{ z.dtype_alias }}>
class {{ kernel_class }} {
public:
    __aicore__ inline {{ kernel_class }}() {}
    __aicore__ inline void Init(GM_ADDR {{ x.name }}, GM_ADDR {{ y.name }}, GM_ADDR {{ z.name }}, uint32_t totalLength, uint32_t tileNum)
    {
        this->blockLength = totalLength / AscendC::GetBlockNum();
        this->tileNum = tileNum;
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;
        {{ x.name }}Gm.SetGlobalBuffer((__gm__ {{ x.dtype_alias }} *){{ x.name }} + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        {{ y.name }}Gm.SetGlobalBuffer((__gm__ {{ y.dtype_alias }} *){{ y.name }} + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        {{ z.name }}Gm.SetGlobalBuffer((__gm__ {{ z.dtype_alias }} *){{ z.name }} + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        pipe.InitBuffer(inQueue{{ x.cap }}, BUFFER_NUM, this->tileLength * sizeof({{ x.dtype_alias }}));
        pipe.InitBuffer(inQueue{{ y.cap }}, BUFFER_NUM, this->tileLength * sizeof({{ y.dtype_alias }}));
        pipe.InitBuffer(outQueue{{ z.cap }}, BUFFER_NUM, this->tileLength * sizeof({{ z.dtype_alias }}));
    }

    __aicore__ inline void Process()
    {
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
        AscendC::printf("Core %ld executed %d times in total\n", AscendC::GetBlockIdx(), loopCount);
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<{{ x.dtype_alias }}> {{ x.name }}Local = inQueue{{ x.cap }}.AllocTensor<{{ x.dtype_alias }}>();
        AscendC::LocalTensor<{{ y.dtype_alias }}> {{ y.name }}Local = inQueue{{ y.cap }}.AllocTensor<{{ y.dtype_alias }}>();
        AscendC::DataCopy({{ x.name }}Local, {{ x.name }}Gm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy({{ y.name }}Local, {{ y.name }}Gm[progress * this->tileLength], this->tileLength);
        inQueue{{ x.cap }}.EnQue({{ x.name }}Local);
        inQueue{{ y.cap }}.EnQue({{ y.name }}Local);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<{{ x.dtype_alias }}> {{ x.name }}Local = inQueue{{ x.cap }}.DeQue<{{ x.dtype_alias }}>();
        AscendC::LocalTensor<{{ y.dtype_alias }}> {{ y.name }}Local = inQueue{{ y.cap }}.DeQue<{{ y.dtype_alias }}>();
        AscendC::LocalTensor<{{ z.dtype_alias }}> {{ z.name }}Local = outQueue{{ z.cap }}.AllocTensor<{{ z.dtype_alias }}>();
        AscendC::Add({{ z.name }}Local, {{ x.name }}Local, {{ y.name }}Local, this->tileLength);
        outQueue{{ z.cap }}.EnQue<{{ z.dtype_alias }}>({{ z.name }}Local);
        inQueue{{ x.cap }}.FreeTensor({{ x.name }}Local);
        inQueue{{ y.cap }}.FreeTensor({{ y.name }}Local);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<{{ z.dtype_alias }}> {{ z.name }}Local = outQueue{{ z.cap }}.DeQue<{{ z.dtype_alias }}>();
        AscendC::DataCopy({{ z.name }}Gm[progress * this->tileLength], {{ z.name }}Local, this->tileLength);
        outQueue{{ z.cap }}.FreeTensor({{ z.name }}Local);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, QUEUE_DEPTH> inQueue{{ x.cap }};
    AscendC::TQue<AscendC::TPosition::VECIN, QUEUE_DEPTH> inQueue{{ y.cap }};
    AscendC::TQue<AscendC::TPosition::VECOUT, QUEUE_DEPTH> outQueue{{ z.cap }};
    AscendC::GlobalTensor<{{ x.dtype_alias }}> {{ x.name }}Gm;
    AscendC::GlobalTensor<{{ y.dtype_alias }}> {{ y.name }}Gm;
    AscendC::GlobalTensor<{{ z.dtype_alias }}> {{ z.name }}Gm;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};


__global__ __aicore__ void {{ op_snake }}(GM_ADDR {{ x.name }}, GM_ADDR {{ y.name }}, GM_ADDR {{ z.name }}, GM_ADDR workspace, GM_ADDR tiling)
{
    REGISTER_TILING_DEFAULT({{ tiling_struct }});
    GET_TILING_DATA_WITH_STRUCT({{ tiling_struct }}, tiling_data, tiling);
    {{ kernel_class }}<{{ x.macro_alias }}, {{ y.macro_alias }}, {{ z.macro_alias }}> op;
    op.Init({{ x.name }}, {{ y.name }}, {{ z.name }}, tiling_data.totalLength, tiling_data.tileNum);
    op.Process();
}
